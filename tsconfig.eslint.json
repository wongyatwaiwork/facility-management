{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals", "@playwright/test"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "e2e/**/*.ts", "*.ts", "*.js"]
}
