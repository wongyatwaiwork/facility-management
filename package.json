{
  "name": "facility-maintenance-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal full-stack portfolio demo for fictional facility maintenance operations.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @musterwerk/api\" \"npm run dev -w @musterwerk/web\"",
    "build": "npm run build -w @musterwerk/api && npm run build -w @musterwerk/web",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -ws --if-present",
    "test:unit": "npm run test:unit -ws --if-present",
    "test:integration": "npm run test:integration -w @musterwerk/api",
    "db:generate": "npm run db:generate -w @musterwerk/api",
    "db:migrate": "npm run db:migrate -w @musterwerk/api",
    "db:migrate:test": "npm run db:migrate:test -w @musterwerk/api",
    "db:seed": "npm run db:seed -w @musterwerk/api",
    "db:validate": "npm run db:validate -w @musterwerk/api",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.19.1"
  },
  "type": "module",
  "dependencies": {
    "qs": "^6.16.0"
  }
}
